# Copy to .env (or set in Vercel -> Environment Variables). Not needed for `python demo.py`.
# --- login to the dashboard
STATS_USER=admin
STATS_PASSWORD=your-password-here
SESSION_SECRET=your-random-session-secret
CRON_SECRET=your-cron-secret
PUBLIC_URL=https://dashboard.example.com
# --- database (empty = local SQLite in DATA_DIR)
NEW_POSTGRES_URL=
DATA_DIR=./data
CONF_DIR=./conf
# --- Instagram bot (Meta app)
IG_TOKEN=your-instagram-token-here
INSTAGRAM_APP_SECRET=your-app-secret-here
FACEBOOK_APP_SECRET=your-app-secret-here
WEBHOOK_VERIFY_TOKEN=your-verify-token-here
META_IG_USER_ID=
META_IG_TOKEN=your-token-here
META_GRAPH_API_VERSION=v25.0
BOT_ENABLED=false
FLOW=welcome
TRACK_BASE_URL=
STATS_EXCLUDE=
# --- Meta Ads (spend -> CPL / ROMI)
META_ADS_TOKEN=your-token-here
META_AD_ACCOUNT=act_000000000
# --- amoCRM
AMO_DOMAIN=YOUR_AMO_SUBDOMAIN
AMO_TOKEN=your-long-lived-token-here
# --- Google Sheets (Apps Script web app, see sheets_script.template.gs)
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
SHEETS_SECRET=your-shared-secret-here
# --- Telegram reports
TELEGRAM_BOT_TOKEN=your-bot-token-here
# --- AI features (optional)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
TRENDS_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
